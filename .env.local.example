# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Model providers -------------------------------------------------------
# Gemini handles the two vision steps (question + answer extraction).
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Groq handles mapping and, by default, grading too.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# --- Optional: Claude grading ----------------------------------------------
# Opt-in. Requires your own paid Anthropic API key, since Claude has no ongoing
# free tier. The app is fully free-tier-compliant without it.
#
# Both of the next two are needed: the flag alone does nothing without a key,
# and a key alone will NOT switch Claude on. That is deliberate - a key sitting
# in the environment for something else should never start spending credits here.
ENABLE_CLAUDE_GRADING=false
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Flags -----------------------------------------------------------------
# "true" runs the whole flow off lib/mock-data.ts with no keys and no network
# calls, which is the quickest way to click through the UI.
# Anything else (or unset) uses the real API routes.
NEXT_PUBLIC_USE_MOCK_DATA=false
