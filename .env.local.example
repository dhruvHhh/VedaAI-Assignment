# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Model providers -------------------------------------------------------
# Gemini handles the two vision steps (question + answer extraction).
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Claude grades the paper (one batched call). Primary provider for grading.
# Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Groq handles mapping, and is the automatic fallback for grading if the Claude
# call fails for any reason (rate limit, timeout, outage, exhausted credit).
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# --- Flags -----------------------------------------------------------------
# "true" runs the whole flow off lib/mock-data.ts with no keys and no network
# calls, which is the quickest way to click through the UI.
# Anything else (or unset) uses the real API routes.
NEXT_PUBLIC_USE_MOCK_DATA=false
